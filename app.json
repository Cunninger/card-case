{
  "expo": {
    "name": "卡匣",
    "slug": "card-cabinet",
    "version": "1.3.0",
    "icon": "./assets/card-case-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.cardcabinet.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/card-case-logo.png",
        "backgroundColor": "#F7F3EA"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许卡匣访问照片，用于保存实体卡照片。"
        }
      ],
      "expo-font",
      "expo-local-authentication",
      "expo-asset"
    ]
  }
}
